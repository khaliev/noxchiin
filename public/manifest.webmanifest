{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "Нохчийн Мотт — учим чеченский язык",
  "short_name": "Нохчийн Мотт",
  "description": "Бесплатная PWA-игра для детей и подростков: чеченский алфавит, цифры, цвета и слова в игровом формате.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#fff9f0",
  "theme_color": "#1b7a46",
  "lang": "ru",
  "dir": "ltr",
  "categories": ["education", "kids", "games"],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
