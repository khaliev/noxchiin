---
// ============================================================================
// index.astro — главный экран: карта тем (уроков).
// Сервер рендерит карточки тем; клиентский скрипт topicMap.js добавляет
// состояние разблокировки/звёзд из localStorage.
// ============================================================================

import Layout from '../layouts/Layout.astro';
import { getAllTopics } from '../scripts/lessons.js';

const topics = getAllTopics();
const totalLessons = topics.filter((t) => !t.comingSoon).length;

// --- FAQ (видимый блок + разметка FAQPage для GEO/SEO) ---
const faq = [
  {
    q: 'Что такое «Нохчийн Мотт»?',
    a: 'Нохчийн Мотт — бесплатная PWA-игра для изучения чеченского языка детьми от 5 лет. Ребёнок в игровом формате учит алфавит, цифры, цвета и базовые слова: слушает звуки, выбирает правильные ответы, собирает слова из букв и зарабатывает звёзды.',
  },
  {
    q: 'Как научить ребёнка чеченскому языку, если семья живёт за границей?',
    a: 'Для детей из диаспоры главное — регулярность и игровой формат. Приложение даёт короткие ежедневные уроки с озвучкой носителя языка, системой сердечек, звёзд и ежедневной серией, что мотивирует заниматься каждый день даже без учителя. Звуки записываются носителями языка, а не синтезатором, чтобы правильно передать специфичные чеченские звуки (абруптивные «пӏ, тӏ, кӏ», гортанная смычка «ӏ»).',
  },
  {
    q: 'Для какого возраста подходит приложение?',
    a: 'От 5 лет и старше. Есть два режима: для 5–8 лет — крупные кнопки, больше картинок и меньше текста; для 9+ — более сложная лексика и письмо.',
  },
  {
    q: 'Работает ли «Нохчийн Мотт» без интернета?',
    a: 'Да, это PWA: после первой загрузки приложение работает полностью офлайн — можно заниматься в дороге или в самолёте. Прогресс хранится на устройстве ребёнка.',
  },
  {
    q: 'Нужно ли регистрироваться или передавать личные данные?',
    a: 'Нет, регистрация и аккаунты не требуются. Весь прогресс хранится локально на устройстве. Приложение не собирает личные данные детей (аналитика, если включена, работает без cookies).',
  },
  {
    q: 'Какие темы доступны?',
    a: 'Чеченский алфавит (49 букв), цифры от 1 до 20, цвета, базовые слова (семья, приветствия), а также тематические блоки: еда, животные, части тела. Темы открываются по порядку.',
  },
  {
    q: 'Кто озвучивает слова и буквы?',
    a: 'Аудио записывается носителями чеченского языка. Обычный синтез речи (TTS) не умеет правильно произносить специфичные чеченские звуки, поэтому используются записи носителей (или проверенные открытые аудио-ресурсы как эталон).',
  },
];

// --- Структурированные данные Schema.org ---
const siteUrl = Astro.site?.toString() ?? 'https://noxchiin-mott.example.com';

const webAppJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Нохчийн Мотт',
  alternateName: 'Noxchiin Mott',
  url: siteUrl,
  description: 'Бесплатная PWA-игра для изучения чеченского языка детьми и подростками от 5 лет.',
  applicationCategory: 'EducationalApplication',
  operatingSystem: 'Web',
  inLanguage: ['ru', 'ce'],
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  publisher: {
    '@type': 'Organization',
    name: 'Нохчийн Мотт',
  },
};

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<Layout>
  <!-- Структурированные данные Schema.org (JSON-LD) -->
  <script is:inline type="application/ld+json" set:html={JSON.stringify(webAppJsonLd)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  <section class="hero hero--compact">
    <div class="container">
      <h1 class="hero__title">Нохчийн <span>Мотт</span></h1>
      <p class="hero__subtitle">Учи чеченский язык играя — буква за буквой, слово за словом.</p>
    </div>
  </section>

  <section class="container section" aria-labelledby="map-title">
    <div class="section__header">
      <h2 id="map-title">Выбери тему</h2>
      <p class="section__meta">{totalLessons} тем · от простого к сложному</p>
    </div>

    <!-- Переключатель возраста: 5–8 лет — крупнее и проще, 9+ — сложнее -->
    <div class="age-toggle" role="group" aria-label="Возрастной режим">
      <button class="age-toggle__btn" data-age="5-8" aria-pressed="true">🧸 5–8 лет</button>
      <button class="age-toggle__btn" data-age="9+" aria-pressed="false">📚 9+ лет</button>
    </div>

    <ol class="topic-map">
      {
        topics.map((topic) => {
          const comingSoon = Boolean(topic.comingSoon);
          const itemCount = topic.items?.length ?? 0;
          return (
            <li
              class="topic-card"
              data-topic-id={topic.id}
              data-order={topic.order}
            >
              {
                comingSoon ? (
                  <span class="topic-card__inner topic-card__inner--static">
                    <span class="topic-card__icon" aria-hidden="true">{topic.icon}</span>
                    <span class="topic-card__body">
                      <span class="topic-card__title">{topic.title.ru}</span>
                      <span class="topic-card__ce">{topic.title.ce}</span>
                      <span class="topic-card__meta">скоро 🚀</span>
                    </span>
                  </span>
                ) : (
                  <a class="topic-card__inner" href={`/lesson/${topic.id}/`}>
                    <span class="topic-card__icon" aria-hidden="true">{topic.icon}</span>
                    <span class="topic-card__body">
                      <span class="topic-card__title">{topic.title.ru}</span>
                      <span class="topic-card__ce">{topic.title.ce}</span>
                      <span class="topic-card__meta">{itemCount} карточек</span>
                    </span>
                    <span class="stars" data-stars aria-label="0 из 3 звёзд">
                      <span class="star">★</span><span class="star">★</span><span class="star">★</span>
                    </span>
                  </a>
                )
              }
              <span class="topic-card__lock" aria-hidden="true">🔒</span>
            </li>
          );
        })
      }
    </ol>
  </section>

  <section class="container section" aria-labelledby="how-title">
    <h2 id="how-title">Как играть</h2>
    <div class="feature-grid">
      <article class="card feature">
        <span class="feature__icon" aria-hidden="true">🎧</span>
        <h3>Слушай</h3>
        <p>Нажми на кнопку и послушай, как звучит буква.</p>
      </article>
      <article class="card feature">
        <span class="feature__icon" aria-hidden="true">👆</span>
        <h3>Выбирай</h3>
        <p>Найди правильную букву среди вариантов.</p>
      </article>
      <article class="card feature">
        <span class="feature__icon" aria-hidden="true">⭐</span>
        <h3>Собирай звёзды</h3>
        <p>Отвечай верно — получай звёзды и очки опыта.</p>
      </article>
    </div>
  </section>

  <!-- FAQ: видимый блок (GEO-оптимизация для ИИ-поисковиков) + FAQPage разметка выше -->
  <section class="container section" aria-labelledby="faq-title">
    <h2 id="faq-title">Частые вопросы</h2>
    <div class="faq">
      {
        faq.map((item) => (
          <details class="faq__item">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </section>
</Layout>

<script>
  import { mountTopicMap } from '../scripts/topicMap.js';
  mountTopicMap();
</script>

<style>
  .hero--compact {
    padding: var(--space-6) var(--space-4);
  }
  .hero--compact .hero__title {
    font-size: var(--text-xl);
  }
  .hero--compact .hero__subtitle {
    font-size: var(--text-base);
    margin-bottom: 0;
  }

  .topic-map {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: var(--space-4);
  }

  .age-toggle {
    display: flex;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
    justify-content: center;
    flex-wrap: wrap;
  }

  .age-toggle__btn {
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-pill);
    border: 2px solid var(--color-border);
    background-color: var(--color-surface);
    font-family: inherit;
    font-weight: var(--font-weight-bold);
    font-size: var(--text-md);
    color: var(--color-text-secondary);
    transition: background-color var(--transition-fast), border-color var(--transition-fast);
  }

  .age-toggle__btn--active {
    background-color: var(--color-primary);
    border-color: var(--color-primary);
    color: #fff;
  }

  .age-toggle__btn:focus-visible {
    outline: 3px solid var(--color-info);
    outline-offset: 2px;
  }

  .topic-card {
    position: relative;
    transition: transform var(--transition-fast);
  }

  .topic-card__inner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-5);
    background-color: var(--color-surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    border: 2px solid var(--color-border);
    color: var(--color-text);
    text-decoration: none;
    min-height: 7rem;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }
  a.topic-card__inner:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
    text-decoration: none;
  }

  .topic-card__icon {
    font-size: 2.5rem;
    line-height: 1;
  }

  .topic-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    flex: 1;
  }

  .topic-card__title {
    font-size: var(--text-lg);
    font-weight: var(--font-weight-black);
  }

  .topic-card__ce {
    color: var(--color-primary-dark);
    font-weight: var(--font-weight-bold);
  }

  .topic-card__meta {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  /* Заблокированная тема: приглушаем и показываем замок */
  .topic-card__lock {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    font-size: 1.25rem;
    display: none;
  }

  .topic-card--locked .topic-card__inner {
    opacity: 0.55;
    filter: grayscale(0.4);
  }
  .topic-card--locked .topic-card__lock {
    display: block;
  }
  .topic-card--locked {
    cursor: not-allowed;
  }

  /* Всплывающая подсказка */
  #toast {
    position: fixed;
    left: 50%;
    bottom: var(--space-6);
    transform: translateX(-50%) translateY(150%);
    background-color: var(--color-text);
    color: #fff;
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-pill);
    font-weight: var(--font-weight-bold);
    box-shadow: var(--shadow-lg);
    transition: transform var(--transition-normal);
    z-index: 200;
    max-width: 90vw;
    text-align: center;
  }
  #toast.toast--visible {
    transform: translateX(-50%) translateY(0);
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: var(--space-4);
  }

  /* FAQ */
  .faq {
    max-width: 44rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .faq__item {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-3) var(--space-4);
  }
  .faq__item summary {
    font-weight: var(--font-weight-bold);
    cursor: pointer;
    list-style: none;
    position: relative;
    padding-right: var(--space-4);
  }
  .faq__item summary::-webkit-details-marker {
    display: none;
  }
  .faq__item summary::after {
    content: '+';
    position: absolute;
    right: 0;
    top: 0;
    font-weight: var(--font-weight-black);
  }
  .faq__item[open] summary::after {
    content: '−';
  }
  .faq__item summary:focus-visible {
    outline: 3px solid var(--color-info);
    outline-offset: 2px;
  }
  .faq__item p {
    margin-top: var(--space-2);
    margin-bottom: 0;
    color: var(--color-text-secondary);
  }
</style>
