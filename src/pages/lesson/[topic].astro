---
// ============================================================================
// [topic].astro — экран урока (мини-игра).
// Генерирует по одной странице на каждую готовую тему (getStaticPaths).
// Сервер отдаёт «каркас» (заголовок, описание — для SEO), а саму игру
// монтирует клиентский скрипт lessonGame.js.
// ============================================================================

import Layout from '../../layouts/Layout.astro';
import { getAllTopics } from '../../scripts/lessons.js';

// Создаём страницы только для тем с реальным контентом.
export function getStaticPaths() {
  const topics = getAllTopics().filter((t) => !t.comingSoon && (t.items?.length ?? 0) > 0);
  return topics.map((t) => ({ params: { topic: t.id }, props: { topic: t } }));
}

const { topic } = Astro.props;
---

<Layout title={`${topic.title.ru} — Нохчийн Мотт`} description={topic.description.ru}>
  <section class="container section">
    <header class="lesson-header">
      <a href="/" class="lesson-header__back">← Все темы</a>
      <span class="lesson-header__icon" aria-hidden="true">{topic.icon}</span>
      <h1 class="lesson-header__title">{topic.title.ru}</h1>
      <p class="lesson-header__ce">{topic.title.ce}</p>
      <p class="lesson-header__desc">{topic.description.ru}</p>
    </header>

    <!-- Сюда клиентский скрипт монтирует игру -->
    <div id="game" class="game-container" data-topic={topic.id}></div>
  </section>
</Layout>

<script>
  import { startLessonGame } from '../../scripts/lessonGame.js';
  const container = document.getElementById('game');
  const topicId = container?.dataset.topic;
  if (container && topicId) {
    startLessonGame(container, topicId);
  }
</script>

<style>
  .lesson-header {
    text-align: center;
    margin-bottom: var(--space-5);
  }

  .lesson-header__back {
    display: inline-block;
    margin-bottom: var(--space-3);
    font-weight: var(--font-weight-bold);
  }

  .lesson-header__icon {
    font-size: 3rem;
    display: block;
    margin-bottom: var(--space-2);
  }

  .lesson-header__title {
    margin-bottom: var(--space-1);
  }

  .lesson-header__ce {
    color: var(--color-primary-dark);
    font-weight: var(--font-weight-bold);
    font-size: var(--text-lg);
    margin-bottom: var(--space-2);
  }

  .lesson-header__desc {
    color: var(--color-text-secondary);
    max-width: 36rem;
    margin-inline: auto;
  }

  .game-container {
    max-width: 34rem;
    margin-inline: auto;
  }

  /* --- Общие экраны игры (старт / нет сердечек / тема скоро) --- */
  .game-screen {
    background-color: var(--color-surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    border: 1px solid var(--color-border);
    padding: var(--space-6);
    text-align: center;
  }

  .game-screen--center {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .game-screen__title {
    margin-bottom: var(--space-1);
  }

  .game-screen__sub {
    color: var(--color-text-secondary);
    margin-bottom: var(--space-4);
  }

  /* --- Шапка раунда --- */
  .game__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-4);
    font-weight: var(--font-weight-bold);
  }

  .game__progress {
    color: var(--color-text-secondary);
  }

  .game__hearts {
    color: var(--color-accent);
    font-size: var(--text-lg);
    letter-spacing: 0.1em;
  }

  /* --- Блок озвучки --- */
  .game__prompt {
    text-align: center;
    margin-bottom: var(--space-4);
  }

  .game__prompt-label {
    font-weight: var(--font-weight-bold);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-2);
  }

  .game__speaker {
    font-size: 1.75rem;
  }

  .game__hint {
    margin-top: var(--space-2);
    color: var(--color-gold-dark);
    background-color: var(--color-gold-bg);
    border-radius: var(--radius-md);
    padding: var(--space-2) var(--space-3);
    font-weight: var(--font-weight-bold);
  }

  /* --- Варианты ответа --- */
  .game__options {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }

  .choice__char {
    font-size: var(--text-xl);
    font-weight: var(--font-weight-black);
    color: var(--color-primary-dark);
  }

  .choice__transcription {
    font-size: var(--text-md);
    color: var(--color-text-secondary);
  }

  /* --- Результат --- */
  .stars--result {
    font-size: 2.5rem;
    display: block;
    margin-bottom: var(--space-2);
  }

  .modal__score {
    font-size: var(--text-md);
    margin-bottom: var(--space-1);
  }

  .modal__xp {
    font-size: var(--text-lg);
    font-weight: var(--font-weight-black);
    color: var(--color-gold-dark);
    margin-bottom: 0;
  }

  /* --- Выбор игры (экран старта) --- */
  .game-picker {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
    width: 100%;
  }

  /* --- Маскот-волчонок --- */
  .mascot {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .mascot__wolf {
    font-size: 2.75rem;
    line-height: 1;
  }

  .mascot__bubble {
    background-color: var(--color-surface);
    border: 2px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-2) var(--space-3);
    font-weight: var(--font-weight-bold);
    color: var(--color-text);
    box-shadow: var(--shadow-sm);
  }

  .mascot--bounce {
    animation: mascot-bounce 0.4s ease;
  }
  @keyframes mascot-bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  .mascot--shake {
    animation: mascot-shake 0.4s ease;
  }
  @keyframes mascot-shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-4px); }
    75% { transform: translateX(4px); }
  }

  /* --- Карточки-варианты (дополнительно) --- */
  .choice__chechen {
    font-size: var(--text-lg);
    font-weight: var(--font-weight-black);
    color: var(--color-primary-dark);
  }

  .choice__emoji {
    font-size: 2rem;
    line-height: 1;
  }

  .choice__swatch {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    border: 2px solid var(--color-border);
  }
  .choice__swatch--lg {
    width: 3.25rem;
    height: 3.25rem;
  }

  .card--selected {
    border-color: var(--color-info);
    box-shadow: 0 0 0 3px var(--color-info-bg);
  }

  /* --- Игра «найди пары» --- */
  .game__options--match {
    grid-template-columns: repeat(2, 1fr);
  }
  .card--match {
    min-height: 5rem;
  }
  .card__emoji {
    font-size: 2.5rem;
    line-height: 1;
  }

  /* --- Игра «собери слово» --- */
  .spell__target {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }
  .spell__russian {
    font-size: var(--text-lg);
    font-weight: var(--font-weight-bold);
    color: var(--color-text);
  }
  .spell__answer {
    min-height: 3.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    justify-content: center;
    align-items: center;
    border: 2px dashed var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-2);
    margin-bottom: var(--space-4);
  }
  .spell__placed {
    font-size: var(--text-xl);
    font-weight: var(--font-weight-black);
    color: var(--color-primary-dark);
    animation: star-pop 0.3s ease;
  }
  .spell__tiles {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    justify-content: center;
  }
  .spell__tile {
    min-width: 3.25rem;
    min-height: 3.25rem;
    font-size: var(--text-lg);
    font-weight: var(--font-weight-black);
    border: 2px solid var(--color-primary);
    border-radius: var(--radius-md);
    background-color: var(--color-surface);
    color: var(--color-primary-dark);
    cursor: pointer;
    transition: transform var(--transition-fast), background-color var(--transition-fast);
  }
  .spell__tile:hover {
    background-color: var(--color-primary-bg);
  }
  .spell__tile:active {
    transform: scale(0.92);
  }
  .spell__tile--used {
    opacity: 0.35;
    pointer-events: none;
  }

  /* --- Таймер (викторина на скорость) --- */
  .timer {
    width: 100%;
    height: 0.75rem;
    background-color: var(--color-border);
    border-radius: var(--radius-pill);
    overflow: hidden;
    margin-bottom: var(--space-4);
  }
  .timer__fill {
    height: 100%;
    width: 100%;
    background-color: var(--color-accent);
    border-radius: var(--radius-pill);
    transition: width 1s linear;
  }
</style>
