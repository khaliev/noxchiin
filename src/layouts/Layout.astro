---
// ============================================================================
// Layout.astro — базовый каркас каждой страницы приложения.
// Семантический HTML5: <html lang> <head> <body> <header> <main> <footer>.
// Сюда добавляются общие для всех экранов теги: шрифты, meta, манифест PWA.
// ============================================================================

// Заголовок и описание по умолчанию (можно переопределить на странице).
interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Нохчийн Мотт — учим чеченский язык играя',
  description = 'Бесплатная PWA-игра для детей и подростков: чеченский алфавит, цифры, цвета и слова в игровом формате. Учим язык диаспоры офлайн.',
  image = '/icons/icon-512.png',
} = Astro.props;

// Абсолютные адреса (из astro.config.mjs) — нужны для Open Graph / canonical.
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL(image, Astro.site).toString();

// Cookieless-аналитика (Plausible). Включается только если задан домен.
const plausibleDomain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- hreflang: основной язык русский. При появлении ce/en-версий добавить
         их alternate-ссылки сюда. -->
    <link rel="alternate" hreflang="ru" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />

    <!-- PWA: манифест, иконки и цвет темы -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#1b7a46" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />

    <!-- Content-Security-Policy (уровень meta — сработает даже без заголовков хоста).
         Полный набор security-заголовков задаётся на уровне хостинга
         (см. vercel.json и public/_headers).
         script-src включает plausible.io только для cookieless-аналитики. -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' https://plausible.io; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; media-src 'self'; connect-src 'self' https://plausible.io; worker-src 'self'; manifest-src 'self'; base-uri 'self'; form-action 'self'"
    />

    <!-- Open Graph (превью при шаринге в соцсетях) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Нохчийн Мотт" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:locale:alternate" content="ru_FR" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Шрифт Nunito (кириллица + латиница) с font-display: swap. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Nunito:wght@500;700;900&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/src/styles/global.css" />
    <link rel="stylesheet" href="/src/styles/components.css" />

    {
      plausibleDomain && (
        <script
          is:inline
          defer
          data-domain={plausibleDomain}
          src="https://plausible.io/js/script.js"
        ></script>
      )
    }
  </head>

  <body>
    <header class="site-header">
      <div class="container site-header__inner">
        <a class="brand" href="/">
          <span class="brand__logo" aria-hidden="true">🐺</span>
          <span class="brand__name">Нохчийн Мотт</span>
        </a>

        <!-- HUD-панель (жизни + серия + опыт). Заполняется на клиенте скриптом
             hud.js, потому что прогресс хранится в localStorage. -->
        <div class="site-header__hud" aria-label="Игровой счёт">
          <span class="hud-item hud-item--streak" id="hud-streak">🔥 0</span>
          <span class="hud-item">
            <span id="hud-hearts" class="hearts" role="img" aria-label="Сердечки"></span>
          </span>
          <span class="hud-item hud-item--xp" id="hud-xp">⭐ 0 XP</span>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>Нохчийн Мотт — проект для детей и подростков из чеченской диаспоры.</p>
        <p class="site-footer__note">Учим язык дома и в дороге.</p>
        <nav class="site-footer__nav" aria-label="Дополнительные страницы">
          <a href="/profile/">Профиль</a>
          <a href="/parents/">Для родителей</a>
        </nav>
      </div>
    </footer>

    <!-- Регистрация Service Worker (офлайн-режим). Вынесена во внешний модуль,
         чтобы CSP могла быть строгой (script-src 'self' без unsafe-inline). -->
    <script>
      import '../scripts/registerSW.js';
    </script>
  </body>
</html>

<style>
  /* Локальные стили каркаса (шапка и подвал общие для всех экранов) */
  .site-header {
    background-color: var(--color-primary);
    color: #fff;
    box-shadow: var(--shadow-md);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: var(--space-3);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: #fff;
    text-decoration: none;
  }
  .brand:hover {
    text-decoration: none;
  }

  .brand__logo {
    font-size: 1.75rem;
    line-height: 1;
  }

  .brand__name {
    font-size: var(--text-lg);
    font-weight: var(--font-weight-black);
    letter-spacing: 0.02em;
  }

  .site-header__hud {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
  }

  .hud-item {
    background-color: rgba(255, 255, 255, 0.15);
    border-radius: var(--radius-pill);
    padding: var(--space-1) var(--space-3);
    font-weight: var(--font-weight-bold);
    font-size: var(--text-sm);
  }

  .hud-item .hearts {
    font-size: var(--text-md);
  }

  .site-footer {
    background-color: var(--color-primary-dark);
    color: #d1fae5;
    text-align: center;
    padding-block: var(--space-5);
    margin-top: var(--space-8);
  }
  .site-footer p {
    margin-bottom: var(--space-1);
  }
  .site-footer__note {
    font-size: var(--text-sm);
    opacity: 0.85;
  }

  .site-footer__nav {
    margin-top: var(--space-3);
    display: flex;
    gap: var(--space-4);
    justify-content: center;
    flex-wrap: wrap;
  }
  .site-footer__nav a {
    color: #d1fae5;
    font-weight: var(--font-weight-bold);
    text-decoration: underline;
  }
  .site-footer__nav a:hover {
    color: #fff;
  }
</style>
